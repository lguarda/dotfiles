JS_COMMON = """
function visible(e){
  var r = e.getBoundingClientRect(), s = getComputedStyle(e);
  return r.width > 0 && r.height > 0 && s.visibility !== 'hidden' && s.display !== 'none';
}
function allInputs(root){
  var res = [];
  (function walk(n){
    n.querySelectorAll('input').forEach(function(i){ res.push(i); });
    n.querySelectorAll('*').forEach(function(el){ if (el.shadowRoot) walk(el.shadowRoot); });
  })(root);
  return res;
}
function setVal(el, v){
  el.focus();
  // Use the native setter so React/Vue/Angular notice the change
  Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(el, v);
  el.dispatchEvent(new InputEvent('input', {bubbles: true, composed: true, inputType: 'insertText', data: v}));
  el.dispatchEvent(new Event('change', {bubbles: true}));
}
function activeInput(){
  var el = document.activeElement;
  while (el && el.shadowRoot && el.shadowRoot.activeElement) el = el.shadowRoot.activeElement;
  return (el && el.tagName === 'INPUT') ? el : null;
}
"""

JS_FILL = JS_COMMON + """
(function(u, p){
  var all = allInputs(document).filter(visible);
  var pw = all.filter(function(i){ return i.type === 'password'; });
  var cand = all.filter(function(i){
    var r = i.getAttribute('role');
    return ['text', 'email', 'tel', ''].indexOf(i.type) >= 0 && !i.readOnly && !i.disabled
           && r !== 'combobox' && r !== 'searchbox';
  });
  function score(i){
    var s = 0;
    var t = [i.autocomplete, i.name, i.id, i.placeholder, i.getAttribute('aria-label')].join(' ').toLowerCase();
    if (/username|email/.test(i.autocomplete)) s += 5;
    if (/user|login|email|ident|account/.test(t)) s += 3;
    if (/search|query|find/.test(t)) s -= 5;
    return s;
  }
  var user = null;
  if (pw.length) {
    // the last visible text field before the password field
    var before = cand.filter(function(i){
      return i.compareDocumentPosition(pw[0]) & Node.DOCUMENT_POSITION_FOLLOWING;
    });
    user = before.length ? before[before.length - 1] : null;
  } else if (cand.length) {
    user = cand.slice().sort(function(a, b){ return score(b) - score(a); })[0];
    if (score(user) <= 0 && cand.length > 1) user = null;
  }
  if (!user && !pw.length) { alert('No login field found'); return; }
  if (user && u) setVal(user, u);
  if (pw.length && p) setVal(pw[0], p);
})(__USER__, __PASS__);
"""

JS_SELECTION = JS_COMMON + """
(function(u, p){
  var el = activeInput();
  if (!el) { alert('No input selected'); return; }
  setVal(el, el.type === 'password' ? p : u);
})(__USER__, __PASS__);
"""

JS_TOTP = JS_COMMON + """
(function(t){
  var el = activeInput();
  if (!el) { alert('No TOTP input field selected'); return; }
  setVal(el, t);
})(__TOTP__);
"""


def build_js(js, **values):
    # single pass, so a secret that happens to contain "__PASS__" is never re-substituted
    return re.sub(
        r"__(USER|PASS|TOTP)__",
        lambda m: json.dumps(values.get(m.group(1).lower(), "")),
        js,
    )


def _pipe_unread_bytes(fd):
    buf = bytearray(4)
    fcntl.ioctl(fd, termios.FIONREAD, buf)
    return struct.unpack("i", bytes(buf))[0]


def run_js(js, timeout=5.0):
    """Run JS in the page WITHOUT putting the secrets in the qutebrowser command
    and WITHOUT ever writing them to a file.

    The script is written into a named pipe (FIFO) inside a private 0700
    directory, and qutebrowser is told to run `jseval --file <fifo>`. The only
    thing in the command (and in --debug logs) is the pipe path. The secret
    lives only in the kernel pipe buffer until qutebrowser reads it.

    We hold the pipe open ourselves (O_RDWR) for the whole time, so qutebrowser's
    open() can never block waiting for a writer. If qutebrowser never reads (e.g.
    the command was rejected) we give up after `timeout` seconds and the data is
    discarded together with the pipe.

    let's be honest this sucks but qutebrowser don't provide safer api
    """
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    if not os.path.isdir(runtime):
        runtime = None  # fall back to the default temp dir
    tmpdir = tempfile.mkdtemp(prefix="qute-kpxc-", dir=runtime)  # mode 0700
    path = os.path.join(tmpdir, "run.js")
    fd = None
    try:
        os.mkfifo(path, 0o600)
        fd = os.open(path, os.O_RDWR)  # never blocks on Linux
        data = js.encode("utf-8")
        # a pipe buffers 64 KiB by default; our script is a few KiB
        if os.write(fd, data) != len(data):
            raise RuntimeError("Could not buffer script in pipe")
        qute(f"jseval -q --file {path}")

        # wait until qutebrowser has consumed everything, then close our end
        # so that its read() sees EOF
        deadline = time.monotonic() + timeout
        while _pipe_unread_bytes(fd) > 0:
            if time.monotonic() > deadline:
                raise RuntimeError("qutebrowser did not read the script")
            time.sleep(0.02)
    finally:
        if fd is not None:
            os.close(fd)
        for cleanup in (lambda: os.unlink(path), lambda: os.rmdir(tmpdir)):
            try:
                cleanup()
            except OSError:
                pass


def main():
    if "QUTE_FIFO" not in os.environ:
        print(
            f"No QUTE_FIFO found - {sys.argv[0]} must be run as a qutebrowser userscript"
        )
        sys.exit(-1)

    try:
        args = parse_args()
        assert args.url, "Missing URL"
        kp = connect_to_keepassxc(args)
        if not kp:
            error("Could not connect to KeepassXC")
            return
        creds = kp.get_logins(args.url)
        if not creds:
            error("No credentials found")
            return
        cred = select_account(creds)
        if not cred:
            error("No credentials selected")
            return

        if args.totp:
            totp = cred.get("totp")
            if not totp and cred.get("uuid"):
                totp = kp.get_totp(cred["uuid"])
            if not totp:
                error("No TOTP key found")
                return
            run_js(build_js(JS_TOTP, totp=totp))
            return

        name, pw = cred.get("login"), cred.get("password")
        if not (name or pw):
            error("Entry has no username and no password")
            return
        js = JS_SELECTION if args.selection else JS_FILL
        run_js(build_js(js, user=name or "", **{"pass": pw or ""}))
    except Exception as e:
        error(str(e))


if __name__ == "__main__":
    main()
